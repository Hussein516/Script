local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")

local player = Players.LocalPlayer

local TOP_HEIGHT = 7
local JUMP_COOLDOWN = 0.4

local char, hrp, humanoid
local lockedPart   = nil
local lockedOffset = nil
local blockUntil   = 0

local function setup(c)
    lockedPart = nil
    lockedOffset = nil
    blockUntil = 0
    char = c
    hrp = c:WaitForChild("HumanoidRootPart")
    humanoid = c:WaitForChild("Humanoid")
end
if player.Character then setup(player.Character) end
player.CharacterAdded:Connect(setup)

local function getGrabbedPart()
    local gp = Workspace:FindFirstChild("GrabParts")
    if not gp then return nil end
    local grabPart = gp:FindFirstChild("GrabPart")
    if not grabPart then return nil end

    for _, c in ipairs(grabPart:GetChildren()) do
        if c:IsA("WeldConstraint") then
            local other
            if c.Part0 == grabPart then other = c.Part1
            elseif c.Part1 == grabPart then other = c.Part0
            else other = c.Part1 end

            if other and other:FindFirstAncestor("PalletLightBrown") then
                return other
            end
        end
    end
    return nil
end

local function unlock()
    if lockedPart and hrp and hrp.Parent and humanoid and humanoid.Health > 0 then
        hrp.AssemblyLinearVelocity = lockedPart.AssemblyLinearVelocity + Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
    lockedPart = nil
    lockedOffset = nil
end

local function lockAt(part)
    lockedPart   = part
    lockedOffset = part.CFrame:ToObjectSpace(hrp.CFrame)
end

local function isOverTop(part)
    local lp = part.CFrame:PointToObjectSpace(hrp.Position)
    local half = part.Size * 0.5
    return math.abs(lp.X) <= half.X
        and math.abs(lp.Z) <= half.Z
        and lp.Y >= half.Y - 1
        and lp.Y <= half.Y + TOP_HEIGHT
end

local function isInsideBounds(part, offset)
    local half = part.Size * 0.5
    local p = offset.Position
    return math.abs(p.X) <= half.X and math.abs(p.Z) <= half.Z
end

RunService.Heartbeat:Connect(function(dt)
    if not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then return end

    local part = getGrabbedPart()

    if not part then
        if lockedPart then unlock() end
        return
    end

    if lockedPart and lockedPart ~= part then
        unlock()
        return
    end

    if lockedPart and lockedOffset then
        if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            unlock()
            blockUntil = os.clock() + JUMP_COOLDOWN
            return
        end

        local cf = lockedPart.CFrame * lockedOffset
        local move = humanoid.MoveDirection
        if move.Magnitude > 0 then
            cf = cf + move * humanoid.WalkSpeed * dt
            lockedOffset = lockedPart.CFrame:ToObjectSpace(cf)
        end

        hrp.CFrame = cf

        if not isInsideBounds(lockedPart, lockedOffset) then
            unlock()
            return
        end

        local v = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(0, math.max(v.Y, 0), 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
        return
    end

    if os.clock() < blockUntil then return end

    if isOverTop(part) then
        lockAt(part)
    end
end)
