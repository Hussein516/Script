local function startDodge(fromPos)
    if not hrp then return end
    isDodging = true
    dodgeEndTime = tick() + DODGE_DURATION

    local myPos = hrp.Position
    dodgeDir = (myPos - fromPos).Unit
    if dodgeDir.Magnitude < 0.01 then
        dodgeDir = hrp.CFrame.LookVector * -1
    end
    dodgeDir = Vector3.new(dodgeDir.X, 0, dodgeDir.Z).Unit

    local newPos = myPos + dodgeDir * TELEPORT_DIST
    hrp.CFrame = CFrame.new(newPos, newPos + dodgeDir)
end

local function detectAnimations()
    if not hrp then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local oHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            local oHum = plr.Character:FindFirstChild("Humanoid")
            if oHRP and oHum and (hrp.Position - oHRP.Position).Magnitude <= DETECT_RADIUS then
                local animator = oHum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        local name = track.Name:lower()
                        local id = track.Animation and track.Animation.AnimationId or ""
                        for _, sign in ipairs(ATTACK_SIGNS) do
                            if name:find(sign:lower()) or id:find(sign) then
                                startDodge(oHRP.Position)
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function detectTools()
    if not hrp then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local oHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if oHRP and (hrp.Position - oHRP.Position).Magnitude <= TOOL_RANGE then
                if plr.Character:FindFirstChildOfClass("Tool") then
                    local look = oHRP.CFrame.LookVector
                    local toMe = (hrp.Position - oHRP.Position).Unit
                    if look:Dot(toMe) > FACE_THRESHOLD then
                        startDodge(oHRP.Position)
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function detectMovingParts()
    if not hrp then return false end
    local myPos = hrp.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local oHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if oHRP and (myPos - oHRP.Position).Magnitude <= DETECT_RADIUS then
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        for _, keyword in ipairs({"Hand", "Foot", "Arm", "Leg", "Handle"}) do
                            if part.Name:find(keyword) then
                                local dist = (myPos - part.Position).Magnitude
                                if dist <= PART_RANGE and part.AssemblyLinearVelocity.Magnitude >= MIN_VELOCITY then
                                    startDodge(part.Position)
                                    return true
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function setupCharacter(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")
end

if LocalPlayer.Character then
    setupCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupCharacter)

local lastAttackTime = 0
local lastChestTime = 0
local lastTrainTime = 0

RunService.Heartbeat:Connect(function()
    local now = tick()

    if shieldEnabled and hrp and hum and hum.Health > 0 then
        if isDodging then
            if now < dodgeEndTime then
                hrp.AssemblyLinearVelocity = dodgeDir * DODGE_VELOCITY
            else
                isDodging = false
            end
        else
            if not detectAnimations() then
                if not detectTools() then
                    detectMovingParts()
                end
            end
        end
    end

    if killAuraEnabled and now - lastAttackTime >= 0.013 then
        lastAttackTime = now
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local myPos = myChar.HumanoidRootPart.Position
            for _, target in ipairs(Players:GetPlayers()) do
                if target ~= LocalPlayer and target.Character then
                    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                    if tHRP and tHum and tHum.Health > 0 then
                        local dx = myPos.X - tHRP.Position.X
                        local dy = myPos.Y - tHRP.Position.Y
                        local dz = myPos.Z - tHRP.Position.Z
                        if dx*dx + dy*dy + dz*dz <= 40000 then
                            pcall(function()
                                PunchRemote:FireServer("PUNCH", target)
                            end)
                        end
                    end
                end
            end
        end
    end

    if autoChestEnabled and now - lastChestTime >= 0.5 then
        lastChestTime = now
        if firstChestReady then
            pcall(function()
                ChestsRemote:FireServer("SELECTPRIZE", "FirstChest")
            end)
        end
        if secondChestReady then
            pcall(function()
                ChestsRemote:FireServer("SELECTPRIZE", "SecondChest")
            end)
        end
    end

    if autoTrainEnabled and now - lastTrainTime >= 0.1 then
        lastTrainTime = now
        pcall(function()
            TrainRemote:FireServer("999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999")
        end)
    end
end)

