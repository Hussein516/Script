local function startDodge(fromPos)
    if not hrp then return end
    isDodging = true
    dodgeEndTime = tick() + DODGE_DURATION

    local myPos = hrp.Position
    dodgeDir = (myPos - fromPos).Unit
    if dodgeDir.Magnitude < 0.01 then
        dodgeDir = hrp.CFrame.LookVector * -1
    end
    dodgeDir = Vector3.new(dodgeDir.X, 0, dodgeDir.Z).Unit

    local newPos = myPos + dodgeDir * TELEPORT_DIST
    hrp.CFrame = CFrame.new(newPos, newPos + dodgeDir)
end

local function detectAnimations()
    if not hrp then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local oHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            local oHum = plr.Character:FindFirstChild("Humanoid")
            if oHRP and oHum and (hrp.Position - oHRP.Position).Magnitude <= DETECT_RADIUS then
                local animator = oHum:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        local name = track.Name:lower()
                        local id = track.Animation and track.Animation.AnimationId or ""
                        for _, sign in ipairs(ATTACK_SIGNS) do
                            if name:find(sign:lower()) or id:find(sign) then
                                startDodge(oHRP.Position)
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function detectTools()
    if not hrp then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local oHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if oHRP and (hrp.Position - oHRP.Position).Magnitude <= TOOL_RANGE then
                if plr.Character:FindFirstChildOfClass("Tool") then
                    local look = oHRP.CFrame.LookVector
                    local toMe = (hrp.Position - oHRP.Position).Unit
                    if look:Dot(toMe) > FACE_THRESHOLD then
                        startDodge(oHRP.Position)
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function detectMovingParts()
    if not hrp then return false end
    local myPos = hrp.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local oHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if oHRP and (myPos - oHRP.Position).Magnitude <= DETECT_RADIUS then
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        for _, keyword in ipairs({"Hand", "Foot", "Arm", "Leg", "Handle"}) do
                            if part.Name:find(keyword) then
                                local dist = (myPos - part.Position).Magnitude
                                if dist <= PART_RANGE and part.AssemblyLinearVelocity.Magnitude >= MIN_VELOCITY then
                                    startDodge(part.Position)
                                    return true
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function setupCharacter(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    hrp = char:WaitForChild("HumanoidRootPart")
end

if LocalPlayer.Character then
    setupCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupCharacter)

RunService.Heartbeat:Connect(function()
    if not scriptEnabled or not hrp or not hum or hum.Health <= 0 then return end

    if isDodging then
        if tick() < dodgeEndTime then
            hrp.AssemblyLinearVelocity = dodgeDir * DODGE_VELOCITY
        else
            isDodging = false
        end
    else
        if not detectAnimations() then
            if not detectTools() then
                detectMovingParts()
            end
        end
    end
end)

