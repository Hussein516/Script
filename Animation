local currentCleanup=nil
local running=false
local kicked=false

local function Run()
    if running then return end
    running=true; currentCleanup=nil; button.Visible=false; kicked=false
    local char=lp.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then running=false; button.Visible=true; return end
    local model=nil; local stopAnim=nil; local controls=nil; local saved=nil
    local function cleanup()
        if kicked then return end
        if stopAnim then pcall(stopAnim) end
        if model then pcall(function() model:Destroy() end) end
        if saved then
            set(root,"Anchored",saved.an)
            set(hum,"WalkSpeed",saved.ws)
            set(hum,"JumpPower",saved.jp)
            set(hum,"JumpHeight",saved.jh)
            set(hum,"AutoRotate",saved.ar)
        end
        if controls then pcall(function() controls:Enable() end) end
        stopAnim=nil; model=nil; saved=nil; controls=nil
        running=false; button.Visible=true
    end
    currentCleanup=cleanup
    model=BuildModel()
    if not model then cleanup(); return end
    local mroot=model:FindFirstChild("HumanoidRootPart")
    if not mroot then cleanup(); return end
    model.Name=Data.Name; mroot.Anchored=true; model.Parent=workspace
    local cam=workspace.CurrentCamera
    local dir=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
    if dir.Magnitude<0.1 then local lv=root.CFrame.LookVector; dir=Vector3.new(lv.X,0,lv.Z) end
    if dir.Magnitude<0.01 then dir=Vector3.new(0,0,-1) end
    dir=dir.Unit
    local base=root.Position
    local cpos=base+dir*DISTANCE
    model:PivotTo(CFrame.lookAt(cpos,Vector3.new(base.X,cpos.Y,base.Z)))
    local bc,bs=model:GetBoundingBox()
    local gp=rayGround(cpos,{char,model})
    if gp then
        local bottom=bc.Position.Y-bs.Y/2
        model:PivotTo(model:GetPivot()+Vector3.new(0,gp.Y-bottom,0))
    end
    saved={ws=hum.WalkSpeed,jp=hum.JumpPower,jh=hum.JumpHeight,ar=hum.AutoRotate,an=root.Anchored}
    set(hum,"WalkSpeed",0); set(hum,"JumpPower",0); set(hum,"JumpHeight",0); set(hum,"AutoRotate",false)
    set(root,"AssemblyLinearVelocity",Vector3.zero)
    set(root,"CFrame",CFrame.lookAt(root.Position,Vector3.new(cpos.X,root.Position.Y,cpos.Z)))
    set(root,"Anchored",true)
    pcall(function()
        controls=require(lp.PlayerScripts:FindFirstChild("PlayerModule")):GetControls()
        controls:Disable()
    end)

    stopAnim=startAnimation(model, function()
        -- ===== CRACK MOMENT =====
        -- 1) freezes player anim at last frame + squash (R6/R15)
        pcall(function() SquashPlayer(char) end)
        -- 2) blood right on the ground under the player
        local proot = char and char:FindFirstChild("HumanoidRootPart")
        local bloodPos = proot and proot.Position or (root and root.Position) or Vector3.zero
        pcall(function() SpawnBlood(bloodPos) end)
        -- 3) wait for blood, then real kick
        task.wait(BLOOD_WAIT)
        kicked = true
        local ok=pcall(function() lp:Kick(KICK_REASON) end)
        if not ok then pcall(function() game.Players.LocalPlayer:Kick(KICK_REASON) end) end
    end)
end
local function runSafe()
    local ok=pcall(Run)
    if not ok then
        if currentCleanup then pcall(currentCleanup) end
        running=false; button.Visible=true
    end
end
button.MouseButton1Click:Connect(function() task.spawn(runSafe) end)
env.__BanSceneCleanup=function()
    kicked=false
    if currentCleanup then pcall(currentCleanup) end
    pcall(function() gui:Destroy() end)
end
