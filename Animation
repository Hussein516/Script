local function SpawnBlood(center)
    local folder=Instance.new("Folder"); folder.Name="BloodFX"; folder.Parent=workspace
    local count=26
    for i=1,count do
        local p=Instance.new("Part")
        p.Name="Blood"
        p.Size=Vector3.new(0.35,0.35,0.35)
        p.Color=Color3.fromRGB(150,8,8)
        p.Material=Enum.Material.SmoothPlastic
        p.CanCollide=false; p.CanTouch=false; p.CanQuery=false
        p.Anchored=false; p.Massless=true
        local baseAngle=(i/count)*math.pi*2
        local angle=baseAngle+(math.random()-0.5)*0.7           -- imperfect circle
        local radius=1.2+math.random()*2.8                       -- varied radius
        local px=center.X+math.cos(angle)*radius
        local pz=center.Z+math.sin(angle)*radius
        local py=center.Y-1.4+math.random()*0.3                  -- start near ground
        p.CFrame=CFrame.new(px,py,pz)*CFrame.Angles(
            math.random()*math.pi*2, math.random()*math.pi*2, math.random()*math.pi*2)
        p.Parent=folder
        -- push up + outward (gravity handles the rest)
        local upV=5+math.random()*8
        local outV=radius*0.8
        p.AssemblyLinearVelocity=Vector3.new(math.cos(angle)*outV,upV,math.sin(angle)*outV)
        p.AssemblyAngularVelocity=Vector3.new(
            (math.random()-0.5)*20,(math.random()-0.5)*20,(math.random()-0.5)*20)
        -- fade out shortly after 0.23s
        task.delay(BLOOD_WAIT, function()
            if p and p.Parent then
                pcall(function()
                    TweenService:Create(p,TweenInfo.new(0.15),{Transparency=1}):Play()
                end)
                task.wait(0.18)
                pcall(function() if p and p.Parent then p:Destroy() end end)
            end
        end)
    end
    task.delay(2, function() pcall(function() folder:Destroy() end) end)
end

-- Build tracks
local tracks={}
for name,keys in pairs(DATA) do
    local list={}
    for _,k in ipairs(keys) do
        local es,ed=Enum.EasingStyle.Linear,Enum.EasingDirection.InOut
        pcall(function() es=Enum.EasingStyle[k[8]]; ed=Enum.EasingDirection[k[9]] end)
        list[#list+1]={t=k[1],cf=CFrame.new(k[2],k[3],k[4])*CFrame.fromEulerAnglesXYZ(math.rad(k[5]),math.rad(k[6]),math.rad(k[7])),es=es,ed=ed}
    end
    table.sort(list,function(a,b) return a.t<b.t end)
    tracks[name]=list
end
local function sample(list,t)
    local n=#list
    if t<=list[1].t then return list[1].cf end
    if t>=list[n].t then return list[n].cf end
    for i=2,n do
        local b=list[i]
        if t<=b.t then
            local a=list[i-1]; local span=b.t-a.t
            local alpha=span>0 and (t-a.t)/span or 1
            return a.cf:Lerp(b.cf,TweenService:GetValue(alpha,b.es,b.ed))
        end
    end
    return list[n].cf
end

local function startAnimation(model, onCrack)
    local fxFolder=Instance.new("Folder"); fxFolder.Name="FakeAnimFX"; fxFolder.Parent=workspace
    local active={}; local motors={}; local origs={}; local live={}
    local folder=nil; local elapsed=0; local prevT=-1
    local ending=false; local freezing=false; local fired=false
    local conn
    local function fullCleanup()
        for m,c in pairs(origs) do pcall(function() m.C0=c end) end
        live={}
        if folder then pcall(function() folder:Destroy() end); folder=nil end
        clearFx(active); pcall(function() fxFolder:Destroy() end)
    end
    for _,d in ipairs(model:GetDescendants()) do
        if d:IsA("Motor6D") and tracks[d.Name] and not motors[d.Name] then
            motors[d.Name]=d; origs[d]=d.C0
        end
    end
    folder=Instance.new("Folder"); folder.Name="FakeAnimProps"; folder.Parent=model
    for _,d in ipairs(PROPS) do
        pcall(function() live["P:"..d.name]=buildPropLive(d,model,folder) end)
    end
    local function snapToCrack(tSnap)
        for name,m in pairs(motors) do
            local list=tracks[name]
            if m.Parent and list and #list>0 then
                pcall(function() m.C0=origs[m]*sample(list,tSnap) end)
            end
        end
        for key,v in pairs(live) do
            local list=tracks[key]
            pcall(function()
                if list and #list>0 then v.w.C0=v.base*sample(list,tSnap)
                else v.w.C0=v.base end
            end)
        end
    end
    conn=RunService.RenderStepped:Connect(function(dt)
        dt=dt*SPEED
        stepFx(active,dt)
        if freezing then
            if #active==0 then conn:Disconnect() end
            return
        end
        if ending then
            if #active==0 then conn:Disconnect(); fullCleanup() end
            return
        end
        elapsed=elapsed+dt
        local t=elapsed
        local finished=false
        if LOOP then t=LENGTH>0 and elapsed%LENGTH or 0
        elseif elapsed>=LENGTH then t=LENGTH; finished=true end
        for name,m in pairs(motors) do
            local list=tracks[name]
            if m.Parent and list and #list>0 then
                pcall(function() m.C0=origs[m]*sample(list,t) end)
            end
        end
        for key,v in pairs(live) do
            local list=tracks[key]
            pcall(function()
                if list and #list>0 then v.w.C0=v.base*sample(list,t)
                else v.w.C0=v.base end
            end)
        end
        local wrapped=t<prevT
        for _,f in ipairs(FXS) do
            if crossed(prevT,t,wrapped,f.t) then
                pcall(spawnFx,f,model,live,fxFolder,active)
                if not fired and f.name=="hh" then
                    fired=true
                    snapToCrack(f.t)       -- freeze dummy at crack
                    freezing=true
                    prevT=t
                    if onCrack then task.spawn(onCrack) end
                    return
                end
            end
        end
        prevT=t
        if finished then
            for m,c in pairs(origs) do pcall(function() m.C0=c end) end
            live={}
            if folder then pcall(function() folder:Destroy() end); folder=nil end
            ending=true
        end
    end)
    return function()
        pcall(function() conn:Disconnect() end)
        fullCleanup()
    end
end

