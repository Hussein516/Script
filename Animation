local function partCF(p) return CFrame.new(p.px,p.py,p.pz)*CFrame.fromEulerAnglesXYZ(math.rad(p.rx),math.rad(p.ry),math.rad(p.rz)) end
local function newPart(p,anchored)
    local o=Instance.new(p.shape=="Wedge" and "WedgePart" or "Part")
    if p.shape=="Ball" then o.Shape=Enum.PartType.Ball
    elseif p.shape=="Cylinder" then o.Shape=Enum.PartType.Cylinder end
    o.Name="FAPart"
    o.Size=Vector3.new(math.max(p.sx,0.05),math.max(p.sy,0.05),math.max(p.sz,0.05))
    o.Color=Color3.fromRGB(p.r,p.g,p.b)
    o.Transparency=p.tr or 0; o.Reflectance=p.refl or 0
    pcall(function() o.Material=Enum.Material[p.mat] end)
    o.Anchored=anchored; o.CanCollide=false; o.CanTouch=false; o.CanQuery=false; o.Massless=true
    if p.mt then
        pcall(function()
            local sm=Instance.new("SpecialMesh"); sm.MeshType=Enum.MeshType[p.mt]
            if p.mesh and p.mesh~="" then sm.MeshId=p.mesh end
            if p.tex and p.tex~="" then sm.TextureId=p.tex end
            if p.mnx and p.mnx>0 and p.mny and p.mny>0 and p.mnz and p.mnz>0 then
                sm.Scale=Vector3.new(p.sx/p.mnx,p.sy/p.mny,p.sz/p.mnz)
            else sm.Scale=Vector3.new(p.msx or 1,p.msy or 1,p.msz or 1) end
            sm.Offset=Vector3.new(p.mox or 0,p.moy or 0,p.moz or 0)
            sm.VertexColor=Vector3.new(p.vx or 1,p.vy or 1,p.vz or 1)
            sm.Parent=o
        end)
    end
    if p.dec then
        for _,d in ipairs(p.dec) do
            pcall(function()
                local x=Instance.new(d.c=="Texture" and "Texture" or "Decal")
                x.Face=Enum.NormalId[d.f]; x.Texture=d.t; x.Transparency=d.tr or 0
                if d.c=="Texture" then x.StudsPerTileU=d.u or 2; x.StudsPerTileV=d.v or 2 end
                x.Parent=o
            end)
        end
    end
    return o
end
local function buildPropLive(d,char,folder)
    local target=char:FindFirstChild(d.attach,true)
    if d.attach=="Free" or not (target and target:IsA("BasePart")) then target=char:FindFirstChild("HumanoidRootPart") end
    local base=CFrame.new(d.px,d.py,d.pz)*CFrame.fromEulerAnglesXYZ(math.rad(d.rx),math.rad(d.ry),math.rad(d.rz))
    local pivot=Instance.new("Part")
    pivot.Name="FAPivot"; pivot.Size=Vector3.new(0.2,0.2,0.2); pivot.Transparency=1
    pivot.CanCollide=false; pivot.CanTouch=false; pivot.CanQuery=false; pivot.Massless=true
    pivot.Anchored=false; pivot.CFrame=target.CFrame*base
    local lv={base=base,parts={},pivot=pivot}
    local items={pivot}
    for i,p in ipairs(d.parts) do
        local o=newPart(p,false); local cf=partCF(p); o.CFrame=pivot.CFrame*cf
        local w=Instance.new("Weld"); w.Part0=pivot; w.Part1=o; w.C0=cf; w.Parent=o
        lv.parts[i]={o=o,w=w}; items[#items+1]=o
    end
    local w=Instance.new("Weld"); w.Part0=target; w.Part1=pivot; w.C0=base; w.Parent=pivot
    lv.w=w
    for _,o in ipairs(items) do o.Parent=folder end
    return lv
end
local function fxA(p) return CFrame.new(p.ax,p.ay,p.az)*CFrame.fromEulerAnglesXYZ(math.rad(p.arx),math.rad(p.ary),math.rad(p.arz)) end
local function fxB(p) return CFrame.new(p.bx,p.by,p.bz)*CFrame.fromEulerAnglesXYZ(math.rad(p.brx),math.rad(p.bry),math.rad(p.brz)) end
