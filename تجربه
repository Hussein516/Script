local plrs = game:GetService("Players")
local lp = plrs.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui", pg)
gui.Name = "FastUI_ToggleFix"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 55, 0, 55)
btn.Position = UDim2.new(0.1, 0, 0.4, 0)
btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
btn.Text = "7S"
btn.TextColor3 = Color3.fromRGB(160, 160, 160)
btn.TextSize = 16
btn.Font = Enum.Font.SourceSansBold
btn.Active = true
btn.Draggable = true

local c = Instance.new("UICorner", btn)
c.CornerRadius = UDim.new(1, 0)
local s = Instance.new("UIStroke", btn)
s.Color = Color3.fromRGB(60, 60, 60)
s.Thickness = 2

local function fireClick(element)
    if not element then return end
    pcall(function()
        for _, conn in pairs(getconnections(element.Activated)) do
            conn:Fire()
        end
    end)
    pcall(function()
        for _, conn in pairs(getconnections(element.MouseButton1Click)) do
            conn:Fire()
        end
    end)
end

local function run()
    print("سيدي: بدء العملية...")
    
    -- خطوة 1: العثور على زر فتح القائمة
    local menuGui = pg:FindFirstChild("MenuGui")
    if not menuGui then
        print("سيدي: خطأ - لم يتم العثور على MenuGui الأساسي!")
        return
    end
    
    local topRight = menuGui:FindFirstChild("TopRight")
    if not topRight then
        print("سيدي: خطأ - لم يتم العثور على TopRight!")
        return
    end
    
    local menuBtn = topRight:FindFirstChild("ToysOpenCloseButton")
    if not menuBtn then
        print("سيدي: خطأ - لم يتم العثور على ToysOpenCloseButton!")
        return
    end
    
    -- النقر لفتح القائمة
    print("سيدي: جاري الضغط لفتح القائمة...")
    fireClick(menuBtn)
    
    -- خطوة 2: الانتظار حتى تظهر الخشبة بعد فتح القائمة
    print("سيدي: بانتظار ظهور الخشبة (PalletLightBrown)...")
    local target = nil
    local startTime = tick()
    
    repeat
        task.wait(0.1)
        pcall(function()
            local menu = menuGui:FindFirstChild("Menu")
            if menu then
                local tabContents = menu:FindFirstChild("TabContents")
                if tabContents then
                    local toys = tabContents:FindFirstChild("Toys")
                    if toys then
                        local contents = toys:FindFirstChild("Contents")
                        if contents then
                            target = contents:FindFirstChild("PalletLightBrown")
                        end
                    end
                end
            end
        end)
    until (target ~= nil) or (tick() - startTime > 2) -- مهلة ثانيتين كافية للظهور
    
    if target then
        print("سيدي: تم العثور على الخشبة بنجاح، جاري النقر عليها!")
        fireClick(target)
    else
        print("سيدي: انتهت المهلة، الخشبة لم تظهر داخل القائمة المفتوحة! ربما الاسم مختلف أو المسار تغير.")
    end
end

btn.MouseButton1Click:Connect(function()
    pcall(run)
end)
