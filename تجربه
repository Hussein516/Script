local plrs = game:GetService("Players")
local vim = game:GetService("VirtualInputManager")
local guiSvc = game:GetService("GuiService")
local lp = plrs.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui", pg)
gui.Name = "FastUI_DirectClick"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 55, 0, 55)
btn.Position = UDim2.new(0.1, 0, 0.4, 0)
btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
btn.Text = "7S"
btn.TextColor3 = Color3.fromRGB(160, 160, 160)
btn.TextSize = 16
btn.Font = Enum.Font.SourceSansBold
btn.Active = true
btn.Draggable = true

local c = Instance.new("UICorner", btn)
c.CornerRadius = UDim.new(1, 0)
local s = Instance.new("UIStroke", btn)
s.Color = Color3.fromRGB(60, 60, 60)
s.Thickness = 2

-- دالة ضغط موحدة وسريعة مثل زر الـ Menu تماماً
local function clickIt(obj)
    if not obj then return end
    pcall(function()
        local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
        local tx = pos.X + (sz.X / 2)
        local ty = pos.Y + (sz.Y / 2)
        local inset = guiSvc:GetGuiInset()
        
        local finalX = tx + inset.X
        local finalY = ty + inset.Y
        
        vim:SendTouchEvent(777, 0, finalX, finalY)
        task.wait(0.03)
        vim:SendTouchEvent(777, 2, finalX, finalY)
    end)
end

local function run()
    local menuGui = pg:FindFirstChild("MenuGui")
    if not menuGui then return end
    
    local menuBtn = menuGui:FindFirstChild("TopRight") and menuGui.TopRight:FindFirstChild("ToysOpenCloseButton")
    if menuBtn then
        -- 1. اضغط على الـ Menu مثل العادة
        clickIt(menuBtn)
        
        -- 2. انتظر ظهور الخشبة ثم اضغط عليها بنفس الطريقة فوراً
        local target = nil
        local startTime = tick()
        
        repeat
            task.wait(0.05)
            pcall(function()
                target = menuGui.Menu.TabContents.Toys.Contents:FindFirstChild("PalletLightBrown")
            end)
        until (target and target.AbsoluteSize.X > 0) or (tick() - startTime > 1.5)
        
        if target then
            task.wait(0.05) -- استقرار بسيط لمكان الخشبة على الشاشة
            clickIt(target)  -- اضغط عليها تماماً مثل الـ Menu
        end
    end
end

btn.MouseButton1Click:Connect(function()
    pcall(run)
end)
