local plrs = game:GetService("Players")
local vim = game:GetService("VirtualInputManager")
local guiSvc = game:GetService("GuiService")
local lp = plrs.LocalPlayer

local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "FastUI_ExactPath"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 55, 0, 55)
btn.Position = UDim2.new(0.1, 0, 0.4, 0)
btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
btn.Text = "7S"
btn.TextColor3 = Color3.fromRGB(160, 160, 160)
btn.TextSize = 16
btn.Font = Enum.Font.SourceSansBold
btn.Active = true
btn.Draggable = true

local c = Instance.new("UICorner", btn)
c.CornerRadius = UDim.new(1, 0)
local s = Instance.new("UIStroke", btn)
s.Color = Color3.fromRGB(60, 60, 60)
s.Thickness = 2

local function clickIt(obj)
    if not obj then return end
    pcall(function()
        local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
        local tx = pos.X + (sz.X / 2)
        local ty = pos.Y + (sz.Y / 2)
        local inset = guiSvc:GetGuiInset()
        
        local finalX = tx + inset.X
        local finalY = ty + inset.Y
        
        vim:SendTouchEvent(777, 0, finalX, finalY)
        task.wait(0.03)
        vim:SendTouchEvent(777, 2, finalX, finalY)
    end)
end

local function run()
    -- 1. العثور على زر الـ Menu بالطريقة العادية وضغطه لفتح القائمة
    local pg = lp:FindFirstChild("PlayerGui")
    local menuBtn = pg and pg:FindFirstChild("MenuGui") and pg.MenuGui:FindFirstChild("TopRight") and pg.MenuGui.TopRight:FindFirstChild("ToysOpenCloseButton")
    
    if menuBtn then
        clickIt(menuBtn)
        
        -- 2. الانتظار واستخدام المسار الجديد الذي طلبتَه تماماً للخشبة
        local target = nil
        local startTime = tick()
        
        repeat
            task.wait(0.05)
            pcall(function()
                target = game:GetService("Players").LocalPlayer.IsHeld.MenuGui.Menu.TabContents.Toys.Contents.PalletLightBrown
            end)
        until (target and target.AbsoluteSize.X > 0) or (tick() - startTime > 1.5)
        
        if target then
            task.wait(0.05)
            clickIt(target) -- الضغط على الخشبة بالمسار الجديد مثل الـ Menu تماماً
        end
    end
end

btn.MouseButton1Click:Connect(function()
    pcall(run)
end)
