local function hasWord(name, list)
    local n = name:lower()
    for _, w in ipairs(list) do
        if n:find(w, 1, true) then
            return true
        end
    end
    return false
end

local function collect(char, hum, root, minDy)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(root.Position, 90, params)
    local feetY = root.Position.Y - hum.HipHeight - root.Size.Y / 2
    local list = {}
    for _, p in ipairs(parts) do
        if p:IsA("BasePart") and p.CanCollide and p.Transparency < 0.9 and not visited[p] and not hasWord(p.Name, KILL_WORDS) and p.Size.Magnitude < 200 then
            local top = p.Position.Y + p.Size.Y / 2
            local dy = top - feetY
            local flat = Vector3.new(p.Position.X - root.Position.X, 0, p.Position.Z - root.Position.Z).Magnitude
            if dy > minDy and dy < 80 and flat > 3 and not (flat < 5 and dy < 2) then
                local origin = Vector3.new(p.Position.X, top + 0.5, p.Position.Z)
                local hit = workspace:Raycast(origin, Vector3.new(0, 8, 0), rayParams)
                local goal = hasWord(p.Name, GOAL_WORDS)
                local reach = dy <= 16 and flat <= 28
                local score = dy * 2 - flat * 0.5 + (reach and 10 or 0) - (hit and 45 or 0)
                table.insert(list, { part = p, dy = dy, flat = flat, goal = goal, blocked = hit ~= nil, score = score })
            end
        end
    end
    table.sort(list, function(a, b)
        if a.goal ~= b.goal then
            return a.goal
        end
        return a.score > b.score
    end)
    local trimmed = {}
    for i = 1, math.min(#list, 12) do
        trimmed[i] = list[i]
    end
    return trimmed
end

local function buildPrompt(list, height)
    local lines = {}
    for i, c in ipairs(list) do
        local p = c.part
        local col = p.Color
        table.insert(lines, string.format(
            "%d: %s | flat %d | up %d | size %dx%d | rgb %d,%d,%d%s%s",
            i, p.Name, math.floor(c.flat), math.floor(c.dy), math.floor(p.Size.X), math.floor(p.Size.Z),
            math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255),
            c.blocked and " | blocked above" or "",
            c.goal and " | GOAL" or ""
        ))
    end
    return "Current height: " .. math.floor(height) .. "\nCandidates:\n" .. table.concat(lines, "\n") .. "\nReply with only the index number."
end

local function sendRequest(provider, prompt, useReasoning)
    local payload = {
        model = provider.model,
        temperature = 0,
        max_tokens = provider.groq and 20 or 800,
        messages = {
            { role = "system", content = SYSTEM_PROMPT },
            { role = "user", content = prompt }
        }
    }
    if useReasoning and not provider.groq then
        payload.reasoning = { effort = "low", exclude = true }
    end
    local headers = {
        ["Authorization"] = "Bearer " .. provider.key,
        ["Content-Type"] = "application/json",
        ["Accept"] = "application/json",
        ["User-Agent"] = "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 Chrome/120 Mobile Safari/537.36"
    }
    if not provider.groq then
        headers["HTTP-Referer"] = "https://roblox.com"
        headers["X-Title"] = "Roblox Script"
    end
    local ok, response = pcall(httpRequest, {
        Url = provider.url,
        Method = "POST",
        Headers = headers,
        Body = HttpService:JSONEncode(payload)
    })
    if not ok then
        return nil, nil, tostring(response)
    end
    if not response then
        return nil, nil, "no response"
    end
    local decoded
    pcall(function()
        decoded = HttpService:JSONDecode(response.Body)
    end)
    return response.StatusCode, decoded, tostring(response.Body or "")
end

local function extractNumber(decoded)
    if not (decoded and decoded.choices and decoded.choices[1]) then
        return nil
    end
    local message = decoded.choices[1].message
    if not message then
        return nil
    end
    local content = message.content
    if type(content) == "string" then
        local n = tonumber(content:match("%d+"))
        if n then
            return n
        end
    end
    local reasoning = message.reasoning
    if type(reasoning) == "string" then
        local last
        for num in reasoning:gmatch("%d+") do
            last = num
        end
        return tonumber(last)
    end
    return nil
end

local function errorText(status, decoded, body)
    if decoded and decoded.error then
        local m = decoded.error.message or decoded.error
        return tostring(m):sub(1, 70)
    end
    return tostring(body):gsub("%s+", " "):sub(1, 70)
end

local function askAI(prompt)
    local errors = {}
    for _, provider in ipairs(PROVIDERS) do
        if not running then
            return nil, errors
        end
        local short = provider.model:match("[^/]+$")
        if (blocked[provider.model] or 0) <= os.clock() then
            local box = { done = false }
            task.spawn(function()
                local started = os.clock()
                local status, decoded, body = sendRequest(provider, prompt, true)
                if status == 400 then
                    status, decoded, body = sendRequest(provider, prompt, false)
                end
                box.status = status
                box.decoded = decoded
                box.body = body
                box.index = status == 200 and extractNumber(decoded) or nil
                box.took = os.clock() - started
                box.done = true
            end)
            local waited = 0
            while running and not box.done and waited < provider.timeout do
                task.wait(0.05)
                waited += 0.05
            end
            if box.done and box.index then
                return { index = box.index, model = provider.model, took = box.took }, errors
            end
            if box.done then
                if box.status == 429 or box.status == 401 or box.status == 403 or box.status == 404 then
                    blocked[provider.model] = os.clock() + 20
                end
                local detail
                if box.status == nil then
                    detail = tostring(box.body):sub(1, 70)
                elseif box.status == 200 then
                    detail = "رد بدون رقم"
                else
                    detail = errorText(box.status, box.decoded, box.body)
                end
                table.insert(errors, short .. " [" .. tostring(box.status) .. "] " .. detail)
            else
                blocked[provider.model] = os.clock() + 8
                table.insert(errors, short .. " تأخر")
            end
        else
            table.insert(errors, short .. " موقوف مؤقتاً")
        end
    end
    return nil, errors
end

local function goTo(part, char, root, hum)
    local target = part.Position + Vector3.new(0, part.Size.Y / 2 + 3, 0)
    hum:MoveTo(target)
    hum.Jump = true
    local started = os.clock()
    local lastPos = root.Position
    local lastCheck = started
    while running and os.clock() - started < 3 do
        task.wait(0.1)
        if (root.Position - target).Magnitude < 5 then
            return true
        end
        hum.Jump = true
        if os.clock() - lastCheck > 0.8 then
            if (root.Position - lastPos).Magnitude < 2.5 then
                break
            end
            lastPos = root.Position
            lastCheck = os.clock()
        end
    end
    if not running then
        return false
    end
    hum:MoveTo(root.Position)
    setNoclip(char, true)
    local distance = (target - root.Position).Magnitude
    local tween = TweenService:Create(root, TweenInfo.new(math.clamp(distance / 90, 0.25, 1.2), Enum.EasingStyle.Linear), { CFrame = CFrame.new(target) })
    tween:Play()
    tween.Completed:Wait()
    root.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)
    setNoclip(char, false)
    return true
end

local function startBrain()
    loopId += 1
    local myId = loopId
    task.spawn(function()
        while running and myId == loopId do
            local char, hum, root = getChar()
            if not hum or hum.Health <= 0 then
                setStatus("بانتظار الشخصية...")
                task.wait(1)
            else
                local list = collect(char, hum, root, 2)
                if #list == 0 then
                    list = collect(char, hum, root, -1)
                end
                if #list == 0 then
                    visited = {}
                    setStatus("إعادة البحث...", Color3.fromRGB(255, 200, 50))
                    task.wait(1)
                else
                    setStatus("الذكاء يفكر...", Color3.fromRGB(180, 180, 180))
                    local answer, errors = askAI(buildPrompt(list, root.Position.Y))
                    if not running or myId ~= loopId then
                        break
                    end
                    local choice = answer and list[answer.index]
                    if choice then
                        setStatus(choice.part.Name .. "\n" .. answer.model .. " - " .. string.format("%.1f", answer.took) .. "s", Color3.fromRGB(85, 255, 120))
                        goTo(choice.part, char, root, hum)
                        visited[choice.part] = true
                        if choice.goal then
                            running = false
                            paintButton(AIBtn, false, "تشغيل الذكاء: يعمل", "تشغيل الذكاء: متوقف")
                            setStatus("وصلنا إلى النهاية", Color3.fromRGB(85, 255, 120))
                        end
                    else
                        local why = #errors > 0 and table.concat(errors, "\n", 1, math.min(#errors, 3)) or "رد غير صالح"
                        setStatus("فشل الذكاء\n" .. why, Color3.fromRGB(255, 80, 80))
                        task.wait(1.5)
                    end
                end
            end
        end
    end)
end

