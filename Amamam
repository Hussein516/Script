    end
    if slamActive then return end
    if not visualRoot then return end
    slamHeight = SLAM_START
    slamActive = true
end)

local function getVoidY()
    local height = -500
    pcall(function()
        height = workspace.FallenPartsDestroyHeight
    end)
    if type(height) ~= "number" or height ~= height or height < -100000 then
        height = -500
    end
    return height - 50
end

respawnButton.MouseButton1Click:Connect(function()
    if isRunning or activeMode then
        status.Text = "Stop the lock first"
        return
    end
    if respawnBusy then return end

    local root = getMyRoot()
    local humanoid = getMyHumanoid()
    if not (root and humanoid) then return end

    respawnBusy = true
    status.Text = "Going to void"

    task.spawn(function()
        local saved = root.CFrame
        local newCharacter = nil
        local connection = LocalPlayer.CharacterAdded:Connect(function(character)
            newCharacter = character
        end)

        root.CFrame = CFrame.new(saved.X, getVoidY(), saved.Z)
        zeroVelocity(root)
        humanoid.Health = 0

        local startTime = os.clock()
        while not newCharacter and os.clock() - startTime < RESPAWN_TIMEOUT do
            RunService.Heartbeat:Wait()
        end
        connection:Disconnect()

        if newCharacter then
            local newRoot = newCharacter:WaitForChild("HumanoidRootPart", 5)
            if newRoot then
                for _ = 1, RETURN_FRAMES do
                    newRoot.CFrame = saved
                    zeroVelocity(newRoot)
                    RunService.Heartbeat:Wait()
                end
            end
        end

        status.Text = "Idle"
        respawnBusy = false
    end)
end)

updateButtons()

LocalPlayer.CharacterAdded:Connect(function()
    animTrack = nil
    animateScript = nil
    if isRunning then
        stop()
    end
end)
