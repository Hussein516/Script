local stickers = {}

local function loadStickerImage(def)
    local downloadOk = pcall(function()
        if not isfile(def.file) then
            local response = game:HttpGet(def.url)
            writefile(def.file, response)
        end
    end)

    if not downloadOk then
        warn("[Chat] فشل تحميل الملصق:", def.id)
        return nil
    end

    local assetOk, assetId = pcall(function()
        return getcustomasset(def.file)
    end)

    if assetOk and assetId then
        return assetId
    end

    warn("[Chat] فشل تحويل الملصق لصورة روبلوكس:", def.id)
    return nil
end

local pendingDownloads = #stickerDefs
local downloadsDone = Instance.new("BindableEvent")
local rawStickerResults = {}

for i, def in ipairs(stickerDefs) do
    task.spawn(function()
        local assetId = loadStickerImage(def)
        rawStickerResults[i] = assetId
        pendingDownloads -= 1
        if pendingDownloads <= 0 then
            downloadsDone:Fire()
        end
    end)
end

if pendingDownloads > 0 then
    downloadsDone.Event:Wait()
end

for i, def in ipairs(stickerDefs) do
    if rawStickerResults[i] then
        table.insert(stickers, {id = def.id, assetId = rawStickerResults[i]})
    end
end

local function getStickerById(id)
    for _, s in ipairs(stickers) do
        if s.id == id then return s end
    end
    return nil
end

