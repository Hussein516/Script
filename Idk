local function insertStickerAtCursor(stickerId)
    local token = "{{sticker:" .. stickerId .. "}}"
    local textLength = string.len(msgInput.Text)
    local cursorPos = msgInput.CursorPosition

    if cursorPos < 1 or cursorPos > textLength + 1 then
        cursorPos = textLength + 1
    end

    local before = string.sub(msgInput.Text, 1, cursorPos - 1)
    local after = string.sub(msgInput.Text, cursorPos)
    
    msgInput.Text = before .. token .. after
    local newPos = cursorPos + string.len(token)
    
    task.defer(function()
        msgInput:CaptureFocus()
        msgInput.CursorPosition = newPos
    end)
end

