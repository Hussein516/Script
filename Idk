-- ====== تفريغ ورسم محتوى الرسالة ======
local function parseMessageSegments(text)
    local segments = {}
    local pos = 1
    while true do
        local startIdx, endIdx, stickerId = text:find("{{sticker:(%w+)}}", pos)
        if not startIdx then
            if pos <= #text then
                table.insert(segments, {type = "text", value = text:sub(pos)})
            end
            break
        end
        if startIdx > pos then
            table.insert(segments, {type = "text", value = text:sub(pos, startIdx - 1)})
        end
        table.insert(segments, {type = "sticker", value = stickerId})
        pos = endIdx + 1
    end
    return segments
end

local function renderMessageContent(container, text, imgSize)
    for _, child in ipairs(container:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local layout = container:FindFirstChildOfClass("UIListLayout")
    if not layout then
        layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, 6)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = container
    end

    local size = imgSize or 32
    for _, seg in ipairs(parseMessageSegments(text)) do
        if seg.type == "text" and seg.value ~= "" then
            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.AutomaticSize = Enum.AutomaticSize.X
            lbl.Size = UDim2.new(0, 0, 1, 0)
            lbl.TextColor3 = Color3.new(1, 1, 1)
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 15
            lbl.Text = seg.value
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = container
        elseif seg.type == "sticker" then
            local sticker = getStickerById(seg.value)
            if sticker then
                local img = Instance.new("ImageLabel")
                img.Size = UDim2.new(0, size, 0, size)
                img.BackgroundTransparency = 1
                img.Image = sticker.assetId
                Instance.new("UICorner", img).CornerRadius = UDim.new(0, 6)
                img.Parent = container
            end
        end
    end
end

