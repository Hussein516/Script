local function updateSeenLabel(entry)
    local total = #entry.seenOrder
    if total == 0 then
        entry.seenLabel.Text = ""
        return
    end
    local displayNames = {}
    for i = 1, math.min(3, total) do
        local uname = entry.seenOrder[i]
        table.insert(displayNames, userAliases[uname] or uname)
    end
    local text = "شاهدها: " .. table.concat(displayNames, "، ")
    if total > 3 then
        text = text .. " وآخرون"
    end
    entry.seenLabel.Text = text
end

local function createMessageFrame(username, text, id)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 64)
    frame.BackgroundColor3 = Color3.fromRGB(45, 60, 100)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -10, 0, 20)
    nameLabel.Position = UDim2.new(0, 5, 0, 2)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

    local displayName = userAliases[username] or username
    nameLabel.Text = "[" .. displayName .. "]"

    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 12
    nameLabel.Parent = frame

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -10, 0, 25)
    textLabel.Position = UDim2.new(0, 5, 0, 22)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.Text = text
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextSize = 14
    textLabel.Parent = frame

    if username == LocalPlayer.Name then
        local seenLabel = Instance.new("TextLabel")
        seenLabel.Size = UDim2.new(1, -10, 0, 12)
        seenLabel.Position = UDim2.new(0, 5, 1, -13)
        seenLabel.BackgroundTransparency = 1
        seenLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
        seenLabel.Font = Enum.Font.Gotham
        seenLabel.TextSize = 10
        seenLabel.TextXAlignment = Enum.TextXAlignment.Left
        seenLabel.Text = ""
        seenLabel.Parent = frame

        local entry = { frame = frame, seenLabel = seenLabel, isOwn = true, seenSet = {}, seenOrder = {} }
        messageFramesById[id] = entry

        frame.Destroying:Connect(function()
            messageFramesById[id] = nil
        end)
    end

    frame.Parent = messagesContainer

    local touchStartTime = 0
    local isTouching = false

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isTouching = true
            touchStartTime = tick()

            local startPos = input.Position
            local cancelled = false
            local MOVE_THRESHOLD = 12

            local moveConn
            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if moveInput.UserInputType == input.UserInputType then
                    local delta = (moveInput.Position - startPos).Magnitude
                    if delta > MOVE_THRESHOLD then
                        cancelled = true
                    end
                end
            end)

            task.delay(0.6, function()
                if moveConn then moveConn:Disconnect() end

                if isTouching and not cancelled and (tick() - touchStartTime) >= 0.5 then
                    local blur = Instance.new("BlurEffect")
                    blur.Size = 15
                    blur.Name = "ChatBlur"
                    blur.Parent = Lighting

                    local shadow = Instance.new("UIStroke")
                    shadow.Thickness = 3
                    shadow.Color = Color3.new(0, 0, 0)
                    shadow.Transparency = 0.5
                    shadow.Parent = frame

                    frame.ZIndex = 10

                    local renameGui = Instance.new("ScreenGui", sgui)
                    local rFrame = Instance.new("Frame", renameGui)
                    rFrame.Size = UDim2.new(0, 250, 0, 80)
                    rFrame.Position = UDim2.new(0.5, -125, 0.5, -40)
                    rFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    Instance.new("UICorner", rFrame).CornerRadius = UDim.new(0, 8)

                    local rInput = Instance.new("TextBox", rFrame)
                    rInput.Size = UDim2.new(1, -20, 0, 40)
                    rInput.Position = UDim2.new(0, 10, 0, 20)
                    rInput.PlaceholderText = "اكتب الاسم الجديد واضغط السهم/Enter"
                    rInput.Text = ""
                    rInput.TextColor3 = Color3.new(1, 1, 1)
                    rInput.BackgroundTransparency = 0.8

                    rInput.FocusLost:Connect(function(enterPressed)
                        if enterPressed and rInput.Text ~= "" then
                            userAliases[username] = rInput.Text
                            saveAliases()
                            nameLabel.Text = "[" .. rInput.Text .. "]"
                        end
                        blur:Destroy()
                        shadow:Destroy()
                        frame.ZIndex = 1
                        renameGui:Destroy()
                    end)
                    rInput:CaptureFocus()
                end
            end)
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isTouching = false
        end
    end)

    return frame
end

local function displayNewMessage(username, text, id)
    if processedIds[id] then return end
    processedIds[id] = true

    if username ~= LocalPlayer.Name then
        playNotifySound()
        if not (sendFrame.Visible and msgInput.Text ~= "") then
            showUnread()
        end
        task.spawn(function()
            pcall(function()
                if socket and isConnected then
                    socket:Send(HttpService:JSONEncode({
                        type = "seen",
                        messageId = id,
                        username = LocalPlayer.Name
                    }))
                end
            end)
        end)
    end

    local newFrame = createMessageFrame(username, text, id)
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    if #activeMessages == 2 then
        local bottomMsg = activeMessages[2]
        TweenService:Create(bottomMsg, tweenInfo, {
            Position = UDim2.new(0, 0, 0, 144),
            BackgroundTransparency = 1
        }):Play()
        for _, child in ipairs(bottomMsg:GetChildren()) do
            if child:IsA("TextLabel") then
                TweenService:Create(child, tweenInfo, {TextTransparency = 1}):Play()
            end
        end
        task.delay(0.4, function() bottomMsg:Destroy() end)

        local topMsg = activeMessages[1]
        TweenService:Create(topMsg, tweenInfo, {Position = UDim2.new(0, 0, 0, 72)}):Play()

        newFrame.Position = UDim2.new(0, 0, 0, -72)
        TweenService:Create(newFrame, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()

        activeMessages[2] = activeMessages[1]
        activeMessages[1] = newFrame

    elseif #activeMessages == 1 then
        local topMsg = activeMessages[1]
        TweenService:Create(topMsg, tweenInfo, {Position = UDim2.new(0, 0, 0, 72)}):Play()

        newFrame.Position = UDim2.new(0, 0, 0, -72)
        TweenService:Create(newFrame, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()

        activeMessages[2] = activeMessages[1]
        activeMessages[1] = newFrame

    else
        newFrame.Position = UDim2.new(0, 0, 0, -72)
        TweenService:Create(newFrame, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        activeMessages[1] = newFrame
    end
end

local function sendMessageToCloudflare(text)
    if tick() - lastMessageTime < 0.25 then return end
    lastMessageTime = tick()

    task.spawn(function()
        local encodeOk, payload = pcall(function()
            return HttpService:JSONEncode({
                type = "message",
                username = LocalPlayer.Name,
                message = text
            })
        end)

        if not encodeOk then
            warn("فشل تجهيز الرسالة", payload)
            return
        end

        if not (socket and isConnected) then
            warn("مفيش اتصال حاليًا، الرسالة اتلغت")
            return
        end

        local ok, err = pcall(function()
            socket:Send(payload)
        end)

        if not ok then
            warn("فشل إرسال الرسالة", err)
        end
    end)
end

