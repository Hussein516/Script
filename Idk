-- ====== الاتصال بالسيرفر عبر WebSocket بدل الفحص المتكرر (Polling) ======
local function connectWebSocket()
    local ok, ws = pcall(function()
        return WebSocket.connect(WEBHOOK_URL)
    end)

    if not ok or not ws then
        warn("[Chat] فشل الاتصال، هيتم إعادة المحاولة بعد 2 ثانية")
        isConnected = false
        task.delay(2, connectWebSocket)
        return
    end

    socket = ws
    isConnected = true
    print("[Chat] تم الاتصال بنجاح")

    socket.OnMessage:Connect(function(message)
        local dataSuccess, msg = pcall(function()
            return HttpService:JSONDecode(message)
        end)

        if dataSuccess and type(msg) == "table" and msg.id then
            displayNewMessage(msg.username, msg.message, msg.id)
        end
    end)

    socket.OnClose:Connect(function()
        warn("[Chat] انقطع الاتصال، هيتم إعادة المحاولة بعد 2 ثانية")
        isConnected = false
        socket = nil
        task.delay(2, connectWebSocket)
    end)
end

connectWebSocket()
