local function loadAliases()
    if isfile and isfile(aliasFileName) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(aliasFileName))
        end)
        if success and type(data) == "table" then
            userAliases = data
        end
    end
end

local function saveAliases()
    if writefile then
        writefile(aliasFileName, HttpService:JSONEncode(userAliases))
    end
end
