local function loadOwnerToken()
    if isfile and isfile(TOKEN_FILE) then
        local ok, content = pcall(readfile, TOKEN_FILE)
        if ok and type(content) == "string" then
            local cleaned = content:gsub("%s+", "")
            if #cleaned > 0 then
                return cleaned
            end
        end
    end

    if type(_G) == "table" and type(_G.OWNER_TOKEN) == "string" and #_G.OWNER_TOKEN > 0 then
        return _G.OWNER_TOKEN
    end

    return nil
end

