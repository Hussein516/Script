connectWebSocket = function()
    local ok, ws = pcall(function()
        return WebSocket.connect(WEBHOOK_URL)
    end)

    if not ok or not ws then
        warn("فشل الاتصال، هيتم إعادة المحاولة بعد " .. reconnectDelay .. " ثانية")
        isConnected = false
        task.delay(reconnectDelay, connectWebSocket)
        reconnectDelay = reconnectDelay * 2
        return
    end

    socket = ws
    isConnected = true
    reconnectDelay = 2
    print("تم الاتصال بنجاح")

    socket.OnMessage:Connect(function(message)
        local dataSuccess, msg = pcall(function()
            return HttpService:JSONDecode(message)
        end)

        if not dataSuccess or type(msg) ~= "table" then
            return
        end

        if msg.error == "banned" or msg.error == "kicked" then
            warn("تم طردك من الشات" .. (msg.reason and (": " .. msg.reason) or ""))
        elseif msg.error == "links_not_allowed" then
            warn("مسموحش بإرسال روابط")
        elseif msg.type == "system" then
            warn(msg.message or "")
        elseif msg.type == "typing" then
            if msg.username and msg.username ~= LocalPlayer.Name then
                if msg.typing then
                    typingUsers[msg.username] = true
                else
                    typingUsers[msg.username] = nil
                end
                updateTypingLabelText()
            end
        elseif msg.type == "seen" then
            if msg.messageId and msg.username and msg.username ~= LocalPlayer.Name then
                local entry = messageFramesById[msg.messageId]
                if entry and entry.isOwn and not entry.seenSet[msg.username] then
                    entry.seenSet[msg.username] = true
                    table.insert(entry.seenOrder, msg.username)
                    updateSeenLabel(entry)
                end
            end
        elseif msg.id then
            displayNewMessage(msg.username, msg.message, msg.id)
        end
    end)

    socket.OnClose:Connect(function()
        warn("انقطع الاتصال، هيتم إعادة المحاولة بعد " .. reconnectDelay .. " ثانية")
        isConnected = false
        socket = nil
        task.delay(reconnectDelay, connectWebSocket)
        reconnectDelay = reconnectDelay * 2
    end)
end

connectWebSocket()
