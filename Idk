local function sendMessageToCloudflare(text)
    if tick() - lastMessageTime < 0.25 then return end
    lastMessageTime = tick()

    task.spawn(function()
        local encodeOk, payload = pcall(function()
            return HttpService:JSONEncode({
                username = LocalPlayer.Name,
                message = text
            })
        end)

        if not encodeOk then
            warn("[Chat] فشل تجهيز الرسالة:", payload)
            return
        end

        if not (socket and isConnected) then
            warn("[Chat] مفيش اتصال حاليًا")
            return
        end

        local ok, err = pcall(function()
            socket:Send(payload)
        end)

        if not ok then
            warn("[Chat] فشل إرسال الرسالة:", err)
        end
    end)
end

