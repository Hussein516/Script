local function tryConnect()
    local ok, ws = pcall(function()
        return WebSocket.connect(WEBHOOK_URL)
    end)
    if not ok or not ws then
        warn(("[Chat] فشل الاتصال، إعادة المحاولة بعد %d ثانية"):format(reconnectDelay))
        isConnected = false
        task.delay(reconnectDelay, tryConnect)
        reconnectDelay = math.min(reconnectDelay * 2, RECONNECT_MAX)
        return
    end

    socket = ws
    isConnected = true
    reconnectDelay = 2
    print("[Chat] تم الاتصال بنجاح")

    sendAuthIfPossible()
    registerUsername()

    socket.OnMessage:Connect(function(message)
        local ok2, msg = pcall(function() return HttpService:JSONDecode(message) end)
        if not ok2 or type(msg) ~= "table" then return end

        if msg.error == "kicked" then
            if msg.target and msg.target:lower() == LocalPlayer.Name:lower() then
                isBannedFromChat = true
                pcall(function() socket:Close() end)
                task.wait(0.1)
                local reason = (msg.reason and msg.reason ~= "" and msg.reason) or "لقد قمت بطرد نفسي بنفسي."
                LocalPlayer:Kick(reason)
            end
            return
        elseif msg.error == "banned" then
            isBannedFromChat = true
            pcall(function() socket:Close() end)
            task.wait(0.1)
            LocalPlayer:Kick("أنت محظور من الشات.")
            return
        elseif msg.error == "not_allowed" then
            warn("[Chat] مش مسموحلك تستخدم الأمر ده.")
            return
        elseif msg.error == "links_not_allowed" then
            warn("[Chat] ممنوع إرسال روابط.")
            return
        elseif msg.error == "rate_limited" then
            warn("[Chat] عامل spam كتير، استنى شوية.")
            return
        elseif msg.error == "no_username" then
            warn("[Chat] لم يتم تسجيل اسمك.")
            return
        end

        if msg.type == "ping" then
            pcall(function()
                if socket and isConnected then
                    socket:Send(HttpService:JSONEncode({ type = "pong", t = msg.t }))
                end
            end)
            return
        end

        if msg.type == "auth_ok" then
            hasAuthed = true
            print("[Chat] تم التحقق كمالك - كل الأوامر متاحة")
            return
        elseif msg.type == "auth_fail" then
            hasAuthed = false
            warn("[Chat] توكن المالك غير صحيح - هتشتغل كلاعب عادي")
            return
        end

        if msg.type == "system" then
            warn("[Chat] " .. tostring(msg.message or ""))
            return
        end

        if msg.type == "history" then
            if type(msg.messages) == "table" then
                for _, m in ipairs(msg.messages) do
                    if m.id and m.username and m.message then
                        displayNewMessage(m.username, m.message, m.id, true)
                    end
                end
            end
            return
        end

        if msg.type == "typing" then
            if msg.username and msg.username ~= LocalPlayer.Name then
                if msg.typing then
                    typingUsers[msg.username] = true
                else
                    typingUsers[msg.username] = nil
                end
                updateTypingLabelText()
            end
            return
        end

        if msg.type == "seen" then
            if msg.messageId and msg.username and msg.username ~= LocalPlayer.Name then
                local entry = messageFramesById[msg.messageId]
                if entry and entry.isOwn and not entry.seenSet[msg.username] then
                    entry.seenSet[msg.username] = true
                    table.insert(entry.seenOrder, msg.username)
                    updateSeenLabel(entry)
                end
            end
            return
        end

        if msg.type == "message" or (msg.id and msg.username and msg.message) then
            displayNewMessage(msg.username, msg.message, msg.id, false)
        end
    end)

    socket.OnClose:Connect(function()
        isConnected = false
        socket = nil
        if isBannedFromChat then return end
        warn(("[Chat] انقطع الاتصال، إعادة المحاولة بعد %d ثانية"):format(reconnectDelay))
        task.delay(reconnectDelay, tryConnect)
        reconnectDelay = math.min(reconnectDelay * 2, RECONNECT_MAX)
    end)
end

