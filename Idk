local function createMessageFrame(username, text, id)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 60)
    frame.BackgroundColor3 = Color3.fromRGB(45, 60, 100)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -10, 0, 20)
    nameLabel.Position = UDim2.new(0, 5, 0, 2)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

    local displayName = userAliases[username] or username
    nameLabel.Text = "[" .. displayName .. "]"

    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 13
    nameLabel.Parent = frame
    
    local contentContainer = Instance.new("Frame")
    contentContainer.Size = UDim2.new(1, -10, 0, 34)
    contentContainer.Position = UDim2.new(0, 5, 0, 22)
    contentContainer.BackgroundTransparency = 1
    contentContainer.Parent = frame

    renderMessageContent(contentContainer, text, 32)

    if username == LocalPlayer.Name then
        local sentLabel = Instance.new("TextLabel")
        sentLabel.Size = UDim2.new(0, 80, 0, 12)
        sentLabel.Position = UDim2.new(1, -85, 1, -13)
        sentLabel.BackgroundTransparency = 1
        sentLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
        sentLabel.Font = Enum.Font.Gotham
        sentLabel.TextSize = 10
        sentLabel.TextXAlignment = Enum.TextXAlignment.Right
        sentLabel.Text = "تم الإرسال"
        sentLabel.Parent = frame
    end
    
    frame.Parent = messagesContainer
    
    local touchStartTime = 0
    local isTouching = false

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isTouching = true
            touchStartTime = tick()

            local startPos = input.Position
            local cancelled = false
            local MOVE_THRESHOLD = 12

            local moveConn
            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if moveInput.UserInputType == input.UserInputType then
                    local delta = (moveInput.Position - startPos).Magnitude
                    if delta > MOVE_THRESHOLD then
                        cancelled = true
                    end
                end
            end)

            task.delay(0.6, function()
                if moveConn then moveConn:Disconnect() end

                if isTouching and not cancelled and (tick() - touchStartTime) >= 0.5 then
                    local blur = Instance.new("BlurEffect")
                    blur.Size = 15
                    blur.Name = "ChatBlur"
                    blur.Parent = Lighting
                    
                    local shadow = Instance.new("UIStroke")
                    shadow.Thickness = 3
                    shadow.Color = Color3.new(0, 0, 0)
                    shadow.Transparency = 0.5
                    shadow.Parent = frame
                    
                    frame.ZIndex = 10
                    
                    local renameGui = Instance.new("ScreenGui", sgui)
                    local rFrame = Instance.new("Frame", renameGui)
                    rFrame.Size = UDim2.new(0, 250, 0, 80)
                    rFrame.Position = UDim2.new(0.5, -125, 0.5, -40)
                    rFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                    Instance.new("UICorner", rFrame).CornerRadius = UDim.new(0, 8)
                    
                    local rInput = Instance.new("TextBox", rFrame)
                    rInput.Size = UDim2.new(1, -20, 0, 40)
                    rInput.Position = UDim2.new(0, 10, 0, 20)
                    rInput.PlaceholderText = "اكتب الاسم الجديد واضغط Enter"
                    rInput.Text = ""
                    rInput.TextColor3 = Color3.new(1,1,1)
                    rInput.BackgroundTransparency = 0.8
                    
                    rInput.FocusLost:Connect(function(enterPressed)
                        if enterPressed and rInput.Text ~= "" then
                            userAliases[username] = rInput.Text
                            saveAliases()
                            nameLabel.Text = "[" .. rInput.Text .. "]"
                        end
                        blur:Destroy()
                        shadow:Destroy()
                        frame.ZIndex = 1
                        renameGui:Destroy()
                    end)
                    rInput:CaptureFocus()
                end
            end)
        end
    end)
    
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isTouching = false
        end
    end)

    return frame
end

local function displayNewMessage(username, text, id)
    if processedIds[id] then return end
    processedIds[id] = true

    if username ~= LocalPlayer.Name then
        playNotifySound()
        if not sendFrame.Visible then
            showUnread()
        end
    end
    
    local newFrame = createMessageFrame(username, text, id)
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if #activeMessages == 2 then
        local bottomMsg = activeMessages[2]
        TweenService:Create(bottomMsg, tweenInfo, {
            Position = UDim2.new(0, 0, 0, 145),
            BackgroundTransparency = 1
        }):Play()
        for _, child in ipairs(bottomMsg:GetChildren()) do
            if child:IsA("TextLabel") then
                TweenService:Create(child, tweenInfo, {TextTransparency = 1}):Play()
            end
        end
        task.delay(0.4, function() bottomMsg:Destroy() end)
        
        local topMsg = activeMessages[1]
        TweenService:Create(topMsg, tweenInfo, {Position = UDim2.new(0, 0, 0, 68)}):Play()
        
        newFrame.Position = UDim2.new(0, 0, 0, -68)
        TweenService:Create(newFrame, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        
        activeMessages[2] = activeMessages[1]
        activeMessages[1] = newFrame

    elseif #activeMessages == 1 then
        local topMsg = activeMessages[1]
        TweenService:Create(topMsg, tweenInfo, {Position = UDim2.new(0, 0, 0, 68)}):Play()
        
        newFrame.Position = UDim2.new(0, 0, 0, -68)
        TweenService:Create(newFrame, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        
        activeMessages[2] = activeMessages[1]
        activeMessages[1] = newFrame
        
    else
        newFrame.Position = UDim2.new(0, 0, 0, -68)
        TweenService:Create(newFrame, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()
        activeMessages[1] = newFrame
    end
end

