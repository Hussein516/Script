local function playLaughAnimation()
	local currentCharacter = localPlayer.Character
	if not currentCharacter then return end

	local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
	if not currentHumanoid then return end

	local torso = currentCharacter:FindFirstChild("Torso")
	if not torso then return end

	local animator = currentHumanoid:WaitForChild("Animator")

	if currentLaughTrack then
		currentLaughTrack:Stop(0)
		currentLaughTrack:Destroy()
		currentLaughTrack = nil
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://129423131"
	anim.Name = "LaughAnimation"

	currentLaughTrack = animator:LoadAnimation(anim)
	if currentLaughTrack then
		currentLaughTrack.Priority = Enum.AnimationPriority.Action
		currentLaughTrack.Looped = false
		currentLaughTrack:Play(0)

		local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local shrink = TweenService:Create(buttonFrame, tweenInfo, {Size = UDim2.new(0, 110, 0, 45)})
		local grow = TweenService:Create(buttonFrame, tweenInfo, {Size = UDim2.new(0, 120, 0, 50)})

		shrink:Play()
		shrink.Completed:Connect(function()
			grow:Play()
		end)

		currentLaughTrack.Stopped:Connect(function()
			anim:Destroy()
			if currentLaughTrack == currentLaughTrack then
				currentLaughTrack = nil
			end
		end)
	end
end

clickButton.MouseButton1Click:Connect(playLaughAnimation)

