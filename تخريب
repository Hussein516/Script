local function blockAllPurchaseGuis(guiContainer)
	if not guiContainer then return end
	
	local function destroyIfPurchase(child)
		local name = child.Name:lower()
		if name:find("purchase") or name:find("shop") or name:find("store") or name:find("prompt") or name:find("pass") or name:find("buy") then
			task.defer(function()
				if child and child.Parent then
					child:Destroy()
				end
			end)
		end
	end

	for _, child in ipairs(guiContainer:GetChildren()) do
		destroyIfPurchase(child)
	end
	guiContainer.ChildAdded:Connect(destroyIfPurchase)
end

blockAllPurchaseGuis(localPlayer:FindFirstChildOfClass("PlayerGui"))
localPlayer.ChildAdded:Connect(function(child)
	if child:IsA("PlayerGui") then blockAllPurchaseGuis(child) end
end)

local function isTargetPart(part)
	if not part:IsA("BasePart") then return false end

	local gudock = workspace:FindFirstChild("Gudock")
	if gudock then
		if part == gudock or part:IsDescendantOf(gudock) then
			return true
		end
	end

	if part.Name == "사라지는 파트" then
		return true
	end

	local color = part.Color
	local r = math.floor(color.R * 255 + 0.5)
	local g = math.floor(color.G * 255 + 0.5)
	local b = math.floor(color.B * 255 + 0.5)

	if r == 16 and g == 42 and b == 220 then
		return true
	end

	return false
end

local function addNoAnimScript(tool)
	local s = Instance.new("LocalScript")
	s.Name = "NoHoldAnim"
	s.Source = [[
		local tool = script.Parent
		local player = game.Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
		local animator = humanoid:WaitForChild("Animator")
		local idleAnimId = (humanoid.RigType == Enum.HumanoidRigType.R6) and "rbxassetid://507766388" or "rbxassetid://180435571"
		local idleAnim = Instance.new("Animation")
		idleAnim.AnimationId = idleAnimId
		local currentTrack
		tool.Equipped:Connect(function()
			if currentTrack then currentTrack:Stop() end
			currentTrack = animator:LoadAnimation(idleAnim)
			currentTrack.Priority = Enum.AnimationPriority.Action
			currentTrack:Play()
		end)
		tool.Unequipped:Connect(function()
			if currentTrack then currentTrack:Stop() currentTrack = nil end
		end)
	]]
	s.Parent = tool
end

local function giveTool()
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")
	local character = localPlayer.Character
	if backpack and not backpack:FindFirstChild(toolName) and (not character or not character:FindFirstChild(toolName)) then
		local tool = Instance.new("Tool")
		tool.Name = toolName
		tool.RequiresHandle = true
		tool.CanBeDropped = false

		local handle = Instance.new("Part")
		handle.Name = "Handle"
		handle.Size = Vector3.new(2, 2, 2)
		handle.Transparency = 1
		handle.CanCollide = false
		handle.Massless = true
		handle.Parent = tool

		addNoAnimScript(tool)
		tool.Parent = backpack
	end
end

giveTool()
localPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	giveTool()
end)

RunService.Heartbeat:Connect(function()
	giveTool()

	local character = localPlayer.Character
	if not character then return end
	local toolInHand = character:FindFirstChild(toolName)
	local root = character:FindFirstChild("HumanoidRootPart")
	local handle = toolInHand and toolInHand:FindFirstChild("Handle")

	if not (toolInHand and root and handle) then return end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if isTargetPart(obj) and firetouchinterest then
			firetouchinterest(root, obj, 0)
			firetouchinterest(handle, obj, 0)
			firetouchinterest(root, obj, 1)
			firetouchinterest(handle, obj, 1)
		end
	end
end)

