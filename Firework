local function isCharacterPart(part)
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char and part:IsDescendantOf(char) then return true end
	end
	return false
end

local function grabModel(model)
	if grabbed[model] then return end
	if #grabbedList >= MAX_MODELS then return end
	if not model:IsA("Model") or model.Name ~= TARGET_NAME then return end

	local stick = model:FindFirstChild(STICK_NAME, true)
	if not stick or not stick:IsA("BasePart") then return end

	pcall(function() stick:SetNetworkOwner(LP) end)

	local parts, offsets = {}, {}
	local origAnchored, origCanCollide = {}, {}
	local pivot = model:GetPivot()

	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and not isCharacterPart(p) then
			table.insert(parts, p)
			table.insert(offsets, pivot:ToObjectSpace(p.CFrame))
			table.insert(origAnchored, p.Anchored)
			table.insert(origCanCollide, p.CanCollide)
			p.Anchored   = true
			p.CanCollide = false
		end
	end
	if #parts == 0 then return end

	local entry = {
		model = model, parts = parts, offsets = offsets,
		stick = stick,
		origAnchored = origAnchored, origCanCollide = origCanCollide,
	}
	grabbed[model] = entry
	table.insert(grabbedList, entry)
end

local function cleanup(entry)
	for i, p in ipairs(entry.parts) do
		if p.Parent then
			p.Anchored   = entry.origAnchored[i]
			p.CanCollide = entry.origCanCollide[i]
		end
	end
	grabbed[entry.model] = nil
	for i = #grabbedList, 1, -1 do
		if grabbedList[i] == entry then table.remove(grabbedList, i) break end
	end
end

local function releaseAll()
	for i = #grabbedList, 1, -1 do cleanup(grabbedList[i]) end
	grabbed, grabbedList = {}, {}
	ownerCursor = 0
end

local function updateToggleUI()
	if enabled then
		toggleBtn.Text = "إيقاف"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
	else
		toggleBtn.Text = "تشغيل"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 75)
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	enabled = not enabled
	if not enabled then releaseAll() end
	updateToggleUI()
end)

speedBox.FocusLost:Connect(function()
	local n = tonumber(speedBox.Text)
	if n then rotSpeed = n else speedBox.Text = tostring(rotSpeed) end
end)

radiusBox.FocusLost:Connect(function()
	local n = tonumber(radiusBox.Text)
	if n and n > 1 then circleR = n else radiusBox.Text = tostring(circleR) end
end)

workspace.DescendantAdded:Connect(function(obj)
	if not enabled then return end
	if obj:IsA("Model") and obj.Name == TARGET_NAME then
		task.defer(grabModel, obj)
	end
end)

task.spawn(function()
	while task.wait(SCAN_INTERVAL) do
		if not enabled or #grabbedList >= MAX_MODELS then continue end
		local ok, desc = pcall(function() return workspace:GetDescendants() end)
		if not ok then continue end
		for _, obj in ipairs(desc) do
			if #grabbedList >= MAX_MODELS then break end
			if obj:IsA("Model") and obj.Name == TARGET_NAME and not grabbed[obj] then
				grabModel(obj)
			end
		end
	end
end)

task.spawn(function()
	while task.wait(OWNER_RATE) do
		if not enabled then continue end
		local n = #grabbedList
		if n == 0 then continue end

		local batch = math.min(OWNER_BATCH, n)
		for _ = 1, batch do
			ownerCursor = ownerCursor % n + 1
			local stick = grabbedList[ownerCursor].stick
			if stick and stick.Parent then
				local ok, owner = pcall(function() return stick:GetNetworkOwner() end)
				if ok and owner ~= LP then
					pcall(function() stick:SetNetworkOwner(LP) end)
				end
			end
		end
	end
end)

local function placeEntry(entry, pos, lookAtPos)
	local targetPivot = CFrame.lookAt(pos, lookAtPos)
	for j = 1, #entry.parts do
		local p = entry.parts[j]
		if p.Parent then
			p.CFrame = targetPivot * entry.offsets[j]
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	if not enabled then return end
	local char = LP.Character
	if not char then return end
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if not head then return end

	local count = #grabbedList
	if count == 0 then return end

	spinAngle = (spinAngle - rotSpeed * dt) % (math.pi * 2)

	local base = head.Position + Vector3.new(0, HEIGHT, 0)
	local dead = nil

	for i = 1, count do
		local entry = grabbedList[i]
		if not entry.model.Parent then
			dead = dead or {}
			table.insert(dead, entry)
		else
			local angle = spinAngle + ((i - 1) / count) * math.pi * 2
			local pos = Vector3.new(
				base.X + math.cos(angle) * circleR,
				base.Y,
				base.Z + math.sin(angle) * circleR
			)
			local lookDir = Vector3.new(math.cos(angle), 0, math.sin(angle))
			placeEntry(entry, pos, pos + lookDir)
		end
	end

	if dead then
		for _, e in ipairs(dead) do cleanup(e) end
	end
end)

updateToggleUI()
