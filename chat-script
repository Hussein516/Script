    end
    pendingSeen = {}
end

local function setCollapsed(v)
    collapsed = v
    if v then
        miniBtn.Position = panel.Position
        panel.Visible = false
        miniBtn.Visible = true
    else
        local x, y = clampPos(miniBtn.Position.X.Offset, miniBtn.Position.Y.Offset, panel.AbsoluteSize.X, panel.AbsoluteSize.Y)
        panel.Position = UDim2.fromOffset(x, y)
        miniBtn.Visible = false
        panel.Visible = true
        unread = 0
        updateBadge()
        flushSeen()
        touch()
        stickToBottom(false)
    end
end

local function addMessage(username, text, id, created, silent)
    if id then
        if processed[id] then
            return
        end
        processed[id] = true
    end
    typingUsers[username] = nil
    if isMuted(username) then
        return
    end
    if not silent then
        showBubble(username, text)
    end
    local frame, label = makeLine()
    local stamp = os.date("%H:%M", created and math.floor(created / 1000) or os.time())
    local e = {
        kind = "msg",
        username = username,
        text = text,
        time = stamp,
        frame = frame,
        label = label,
        id = id,
        seenSet = {},
        seenOrder = {},
    }
    renderMessage(e)
    local own = username == LocalPlayer.Name
    if own and id then
        e.seenLabel = new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 12),
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextColor3 = C.dim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "",
            Visible = false,
            LayoutOrder = 2,
        }, frame)
        pad(e.seenLabel, 2, 2, 0, 0)
        ownById[id] = e
    end
    table.insert(entries, e)
    attachLongPress(e)
    trimLines()
    stickToBottom(own and not silent)
    if not silent and not own then
        if settings.sound then
            pcall(function() notifySound:Play() end)
        end
        if collapsed then
            unread += 1
            updateBadge()
            if id then
                table.insert(pendingSeen, id)
            end
        else
            touch()
            if id then
                sendJson({ type = "seen", messageId = id, username = LocalPlayer.Name })
            end
        end
    end
end

local function addWhisper(from, to, text, id, created)
    if id then
        if processed[id] then
            return
        end
        processed[id] = true
    end
    local outgoing = from == LocalPlayer.Name
    local other = outgoing and to or from
    if not outgoing and isMuted(from) then
        return
    end
    local frame, label = makeLine()
    local e = {
        kind = "msg",
        whisper = outgoing and "out" or "in",
        username = other,
        text = text,
        time = os.date("%H:%M", created and math.floor(created / 1000) or os.time()),
        frame = frame,
        label = label,
        seenSet = {},
        seenOrder = {},
    }
    renderMessage(e)
    table.insert(entries, e)
    attachLongPress(e)
    trimLines()
    stickToBottom(outgoing)
    showBubble(from, text)
    if not outgoing then
        typingUsers[from] = nil
        if settings.sound then
            pcall(function() notifySound:Play() end)
        end
        if collapsed then
            unread += 1
            updateBadge()
        else
            touch()
        end
    end
end

local function updateTyping(dots)
    local names = {}
    for name in pairs(typingUsers) do
        if not isMuted(name) then
            table.insert(names, displayName(name))
        end
    end
    local suffix = string.rep(".", dots or 1)
    if #names == 0 then
        typingLabel.Text = onlineText
    elseif #names == 1 then
        typingLabel.Text = names[1] .. " يكتب" .. suffix
    elseif #names == 2 then
        typingLabel.Text = names[1] .. " و" .. names[2] .. " يكتبان" .. suffix
    else
        typingLabel.Text = "عدة أشخاص يكتبون" .. suffix
    end
end

