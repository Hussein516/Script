        e.frame:Destroy()
    end
    entries = {}
    ownById = {}
end

local function submit()
    local text = input.Text:match("^%s*(.-)%s*$")
    input.Text = ""
    typingToken += 1
    setTyping(false)
    if text == "" then
        return
    end
    text = text:sub(1, MAX_LEN)
    local low = text:lower()
    if low == "/clear" then
        clearLines()
        return
    end
    local cmd, arg = text:match("^/(%a+)%s*(.*)$")
    if cmd == "mute" or cmd == "unmute" then
        if arg == "" then
            addSystem("اكتب اسم اللاعب بعد الأمر")
            return
        end
        local target = resolveName(arg)
        if target:lower() == LocalPlayer.Name:lower() then
            addSystem("لا يمكنك كتم نفسك")
            return
        end
        if cmd == "mute" then
            settings.muted[target:lower()] = true
            addSystem("تم كتم " .. displayName(target))
        else
            settings.muted[target:lower()] = nil
            addSystem("تم إلغاء كتم " .. displayName(target))
        end
        writeJson(SETTINGS_FILE, settings)
        return
    end
    if cmd == "w" or cmd == "whisper" then
        local name, body = arg:match("^(%S+)%s+(.+)$")
        if not name then
            if arg ~= "" then
                setWhisperTarget(resolveName(arg))
            else
                addSystem("الاستخدام: /w اسم الرسالة")
            end
            return
        end
        if not isConnected then
            addSystem("غير متصل حاليًا، لم يتم إرسال الرسالة", "#de5e56")
            return
        end
        lastSend = tick()
        sendJson({ type = "whisper", username = LocalPlayer.Name, target = resolveName(name), message = body })
        return
    end
    if not isConnected then
        addSystem("غير متصل حاليًا، لم يتم إرسال الرسالة", "#de5e56")
        return
    end
    if tick() - lastSend < 0.25 then
        return
    end
    lastSend = tick()
    if whisperTarget and text:sub(1, 1) ~= "/" then
        sendJson({ type = "whisper", username = LocalPlayer.Name, target = whisperTarget, message = text })
    else
        sendJson({ type = "message", username = LocalPlayer.Name, message = text })
    end
end

