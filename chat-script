local function httpGet(url)
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and (res.StatusCode == nil or res.StatusCode == 200) then
            return res.Body
        end
    end
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" then
        return body
    end
    return nil
end

local function imageExt(body)
    if body:sub(1, 4) == "\137PNG" then
        return ".png"
    end
    if body:sub(1, 2) == "\255\216" then
        return ".jpg"
    end
    return nil
end

local function fetchImage(id)
    local current = tostring(id)
    for _ = 1, 3 do
        local body = httpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. current)
        if not body or #body < 8 then
            return nil
        end
        local ext = imageExt(body)
        if ext then
            return body, ext
        end
        local nextId = body:match("id=(%d+)") or body:match("rbxassetid://(%d+)")
        if not nextId or nextId == current then
            return nil
        end
        current = nextId
    end
    return nil
end

local function useLogoFile(path)
    local getAsset = getcustomasset or getsynasset
    if not getAsset then
        return false
    end
    local ok, url = pcall(getAsset, path)
    if ok and type(url) == "string" and url ~= "" then
        logo.Image = url
        return true
    end
    return false
end

local function loadLogo()
    if isfile then
        for _, ext in ipairs({ ".png", ".jpg" }) do
            if isfile(LOGO_FILE .. ext) and useLogoFile(LOGO_FILE .. ext) then
                return
            end
        end
    end
    if writefile then
        for _, id in ipairs(LOGO_IDS) do
            if not alive then
                return
            end
            local body, ext = fetchImage(id)
            if body then
                local path = LOGO_FILE .. ext
                local saved = pcall(writefile, path, body)
                if saved and useLogoFile(path) then
                    return
                end
            end
        end
    end
    for _, id in ipairs(LOGO_IDS) do
        if not alive then
            return
        end
        logo.Image = "rbxassetid://" .. id
        local good = false
        pcall(function()
            ContentProvider:PreloadAsync({ logo }, function(_, status)
                good = status == Enum.AssetFetchStatus.Success
            end)
        end)
        if good then
            return
        end
    end
end

