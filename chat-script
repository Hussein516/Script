local function updateSeen(e)
    if not e.seenLabel then
        return
    end
    local total = #e.seenOrder
    if total == 0 then
        e.seenLabel.Visible = false
        return
    end
    local names = {}
    for i = 1, math.min(2, total) do
        table.insert(names, displayName(e.seenOrder[i]))
    end
    local text = "شاهدها: " .. table.concat(names, "، ")
    if total > 2 then
        text = text .. " و" .. (total - 2) .. " آخرين"
    end
    e.seenLabel.Text = text
    e.seenLabel.Visible = true
end

local function refreshAll()
    for _, e in ipairs(entries) do
        if e.kind == "msg" then
            renderMessage(e)
            updateSeen(e)
        end
    end
end

