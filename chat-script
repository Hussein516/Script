local function attachLongPress(e)
    e.frame.InputBegan:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        local cancelled = false
        local origin = inp.Position
        local began = tick()
        local c
        c = inp.Changed:Connect(function()
            if inp.UserInputState == Enum.UserInputState.End then
                c:Disconnect()
                if not cancelled and tick() - began < 0.5 then
                    setWhisperTarget(e.username)
                end
                cancelled = true
            elseif (inp.Position - origin).Magnitude > 10 then
                cancelled = true
            end
        end)
        task.delay(0.7, function()
            if alive and not cancelled then
                cancelled = true
                c:Disconnect()
                openRename(e.username)
            end
        end)
    end)
end

local function addSystem(text, color)
    local frame, label = makeLine()
    label.TextSize = 12
    label.Text = string.format('<font color="%s">%s</font>', color or "#8a909c", esc(text))
    table.insert(entries, { kind = "sys", frame = frame, label = label })
    trimLines()
    stickToBottom(false)
end

local function updateCount()
