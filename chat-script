local function resolveName(arg)
    local low = arg:lower()
    for name in pairs(online) do
        if name:lower() == low or (userAliases[name] and userAliases[name]:lower() == low) then
            return name
        end
    end
    for name in pairs(online) do
        if name:lower():sub(1, #low) == low then
            return name
        end
    end
    return arg
end

local function clearLines()
