-- [5] المحرك الرئيسي سيدي (بأعلى أولوية وسرعة تنفيذ قصوى)
local executionCounter = 0
RunService:BindToRenderStep("FTAP_LOCK", 300, function(deltaTime)
    local myChar = player.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    -- حساب سرعة حركة الكاميرا سيدي
    local currentCFrame = Camera.CFrame
    local angleDifference = math.acos(math.clamp(currentCFrame.LookVector:Dot(lastCameraCFrame.LookVector), -1, 1))
    cameraVelocity = math.deg(angleDifference) / (deltaTime > 0 and deltaTime or 0.016)
    lastCameraCFrame = currentCFrame
    
    -- تحسين التوزيع الذكي للعمليات لتخفيف الضغط الشبكي المعزول مع الحفاظ على القوة الكاملة
    executionCounter = (executionCounter + 1) % 2

    -- فحص ملامسة أي جزء من أجزاء جسم اللاعب المحظور للشاشة تلقائياً والضغط الفوري (مشروط بتفعيل DivineWrath)
    if _G.DivineWrath then 
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character and (not _G.BlacklistOnlyMode or blacklistedPlayers[p.Name]) then
                local pChar = p.Character
                local root = pChar:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - myChar.HumanoidRootPart.Position).Magnitude <= _G.AimRange then
                    for _, part in pairs(pChar:GetChildren()) do
                        if part:IsA("BasePart") then
                            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local distFromCenter = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                                if distFromCenter <= _G.FovSize then
                                    if not isButtonInForbiddenColor() then -- فحص فوري
                                        if (root.Position - myChar.HumanoidRootPart.Position).Magnitude <= _G.AimRange then
                                            triggerTargetElement()
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- نظام التوجيه المقيد بسرعة حركة الكاميرا سيدي
    local target, chosenPartPos = nil, nil
    local selectedPartInstance = nil

    local isMovingFastEnough = not _G.CameraSpeedCheck or (cameraVelocity >= _G.MinCameraVelocity)

    if _G.AimbotEnabled and isMovingFastEnough then
        if _G.ManualObject then 
            target = _G.ManualObject.Parent; 
            chosenPartPos = _G.ManualObject.Position 
        else
            local minFov = _G.FovSize
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj ~= myChar and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                    local root = obj:FindFirstChild("HumanoidRootPart")
                    if root and (root.Position - myChar.HumanoidRootPart.Position).Magnitude <= _G.AimRange then
                        
                        for _, child in pairs(obj:GetChildren()) do
                            if child:IsA("BasePart") then
                                local pos, onScreen = Camera:WorldToViewportPoint(child.Position)
                                if onScreen then
                                    local fovDist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                                    if fovDist < minFov then 
                                        minFov = fovDist; 
                                        target = obj;
                                        selectedPartInstance = child
                                    end
                                end
                            end
                        end

                    end
                end
            end
        end
    end

    if selectedPartInstance then
        if selectedPartInstance ~= currentTargetPart then
            currentTargetPart = selectedPartInstance
            local partSize = selectedPartInstance.Size
            local randomX = (math.random() - 0.5) * (partSize.X * 0.4)
            local randomY = (math.random() - 0.5) * (partSize.Y * 0.4)
            local randomZ = (math.random() - 0.5) * (partSize.Z * 0.4)
            cachedRandomOffset = Vector3.new(randomX, randomY, randomZ)
        end
        
        chosenPartPos = selectedPartInstance.Position + cachedRandomOffset
    else
        currentTargetPart = nil
        cachedRandomOffset = Vector3.new(0, 0, 0)
    end

    if _G.AimbotEnabled and chosenPartPos and isMovingFastEnough then
        local highPowerAlpha = 1 -- سرعة قصوى بدون أي تأخير في الحركة
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, chosenPartPos), highPowerAlpha)
    end
end)

