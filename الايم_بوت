local function checkVictimStatus()
    local count = 0
    for vName, _ in pairs(myVictims) do
        local vPlayer = Players:FindFirstChild(vName)
        if vPlayer and vPlayer.Character then
            local hum = vPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local playingTracks = hum:GetPlayingAnimationTracks()
                local isStillGrabbed = false
                for _, track in pairs(playingTracks) do
                    if track.Animation and tostring(track.Animation.AnimationId) == forbiddenAnimID then
                        isStillGrabbed = true; break
                    end
                end
                if not isStillGrabbed then myVictims[vName] = nil else count = count + 1 end
            end
        else
            myVictims[vName] = nil
        end
    end
    if count == 0 and tick() - lastGrabTime > 0.5 then isPlayerGrabbed = false end
    return count
end

