    isActionCoolingDown = true

    pcall(function()
        local ashleyBtn = player.PlayerGui.ContextActionGui.ContextButtonFrame:GetChildren()[2]
        if ashleyBtn then
            local absolutePosition = ashleyBtn.AbsolutePosition
            local absoluteSize = ashleyBtn.AbsoluteSize
            local targetX = absolutePosition.X + (absoluteSize.X / 2)
            local targetY = absolutePosition.Y + (absoluteSize.Y / 2)
            
            local inset = GuiService:GetGuiInset()
            local finalX = targetX + inset.X
            local finalY = targetY + inset.Y
            
            local customTouchID = 999 
            VirtualInputManager:SendTouchEvent(customTouchID, 0, finalX, finalY)
            VirtualInputManager:SendTouchEvent(customTouchID, 2, finalX, finalY)

            -- استنساخ ونظام الـ FakeAshley المطابق بنسبة 100% والخاص بالوقت واللون سيدي
            task.spawn(function()
                local connection
                local startTime = tick()
                
                connection = RunService.RenderStepped:Connect(function()
                    if tick() - startTime > 1.5 then
                        if connection then connection:Disconnect() end
                        return
                    end
                    
                    pcall(function()
                        local col = ashleyBtn.ImageColor3 or ashleyBtn.BackgroundColor3
